DB_URL=jdbc:postgresql://localhost:5432/db_name
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password

JWT_SECRET=change-this-to-a-random-64-char-string
BOT_TOKEN=your-telegram-bot-token
BOT_USERNAME=your-telegram-bot-username-without-at

# ATMOS card payments: used only when the app runs with the "atmos" profile
# (SPRING_PROFILES_ACTIVE=atmos); otherwise the fake provider is used.
ATMOS_BASE_URL=https://apigw.atmos.uz
ATMOS_CONSUMER_KEY=your-atmos-consumer-key
ATMOS_CONSUMER_SECRET=your-atmos-consumer-secret
ATMOS_STORE_ID=your-atmos-store-id
ATMOS_PLATFORM_RECIPIENT_ID=your-platform-recipient-id
# Optional: fiscal receipt IKPU codes; receipts are sent only when both are set.
ATMOS_OFD_CODE_RENTAL=
ATMOS_OFD_CODE_SERVICE=

# 32 bytes, base64: encrypts saved card tokens at rest (openssl rand -base64 32).
CARD_TOKEN_KEY=

# Browser origins allowed to call the API from another origin, comma-separated, exact
# (e.g. https://admin.minipolya.uz,https://app.minipolya.uz). Empty: no CORS at all.
CORS_ALLOWED_ORIGINS=
