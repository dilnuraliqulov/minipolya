DB_URL=jdbc:postgresql://localhost:5432/db_name
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
# On a managed database that publishes its own variables, these three can be left out and
# taken from DATABASE_URL (postgresql://user:password@host:port/database) or from
# PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD instead. Anything set here always wins.

# Where uploaded stadium photos are stored. Relative to the working directory; on a server
# give an absolute path on persistent storage (e.g. /data/uploads) and back it up with the
# database — a photo row points at a file here. Required under the staging profile.
UPLOADS_DIR=./uploads

# Deployment only. The port to listen on (a host usually sets PORT itself) and the interface
# to bind: SERVER_ADDRESS=:: is needed to answer on an IPv6 private network. Unset locally.
# PORT=8080
# SERVER_ADDRESS=0.0.0.0

JWT_SECRET=change-this-to-a-random-64-char-string
BOT_TOKEN=your-telegram-bot-token
BOT_USERNAME=your-telegram-bot-username-without-at
# webhook (production) or polling (local testing, dev profile only; use a test bot).
TELEGRAM_BOT_MODE=webhook
# Sent by Telegram with every webhook call; 32+ chars of A-Z a-z 0-9 _ - (openssl rand -hex 32).
TELEGRAM_WEBHOOK_SECRET=
# The Mini App's https URL, opened by the bot's buttons and menu button.
MINIAPP_URL=https://your-miniapp.example
# Optional, without @: the support contact the bot shows.
SUPPORT_USERNAME=

# ATMOS card payments: used only when the app runs with the "atmos" profile
# (SPRING_PROFILES_ACTIVE=atmos); otherwise the fake provider is used.
ATMOS_BASE_URL=https://apigw.atmos.uz
ATMOS_CONSUMER_KEY=your-atmos-consumer-key
ATMOS_CONSUMER_SECRET=your-atmos-consumer-secret
ATMOS_STORE_ID=your-atmos-store-id
ATMOS_PLATFORM_RECIPIENT_ID=your-platform-recipient-id
# Optional: fiscal receipt IKPU codes; receipts are sent only when both are set.
ATMOS_OFD_CODE_RENTAL=
ATMOS_OFD_CODE_SERVICE=

# 32 bytes, base64: encrypts saved card tokens at rest (openssl rand -base64 32).
CARD_TOKEN_KEY=

# Only with SPRING_PROFILES_ACTIVE=dev: the dev-only sign-in (/api/auth/dev/*) answers only
# requests sending this in X-Dev-Login-Key. 16+ characters (openssl rand -hex 16); without it
# the app refuses to start under dev. The Mini App's dev build sends VITE_DEV_LOGIN_KEY.
DEV_LOGIN_KEY=

# Browser origins allowed to call the API from another origin, comma-separated, exact
# (e.g. https://admin.minipolya.uz,https://app.minipolya.uz). Empty: no CORS at all.
CORS_ALLOWED_ORIGINS=
