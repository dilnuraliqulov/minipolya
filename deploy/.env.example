# MiniPolya — the AWS test server's configuration.
#
#   cp .env.example .env     then fill every value in, on the SERVER
#   chmod 600 .env           so only your user can read it
#
# .env is git-ignored and must never be committed: it is the one file on the server that
# holds secrets. Generate them ON THE SERVER with the openssl commands below — new ones,
# not the values from your laptop. If a value here ever leaks, it is a server to rebuild,
# not a password to change in two places.
#
# docker compose reads this file for ${...} in docker-compose.yml. Every line is KEY=value:
# no quotes (they become part of the value), no `export`, no spaces around the `=`.
#
# Step 6 of DEPLOYMENT-AWS.md walks through filling this in.


# =========================================================================================
# The host
# =========================================================================================

# The hostname the site answers on and the certificate is issued for — no https://, no
# trailing slash.
#
# With no domain to buy, sslip.io turns an IP into a hostname: write your Elastic IP with
# dashes instead of dots and add .sslip.io. Elastic IP 3.120.45.67 → 3-120-45-67.sslip.io.
# It resolves from anywhere, which is all Let's Encrypt and Telegram need.
#
# A real domain later is the same change: point an A record at the Elastic IP, put the
# domain here, and `docker compose up -d` gets a certificate for it.
SITE_HOST=3-120-45-67.sslip.io

# Where Let's Encrypt emails you before a certificate fails to renew. Optional — HTTPS
# works without it, you just get no warning.
ACME_EMAIL=


# =========================================================================================
# The database
# =========================================================================================
# These three are read on the FIRST start only: the postgres container creates the database
# and the user then. Changing them afterwards has no effect until the postgres_data volume
# is deleted (which deletes the data), so pick them once.

POSTGRES_DB=minipolya
POSTGRES_USER=minipolya

# openssl rand -base64 24
# No `/`, `@`, `:` or `?` worries: it is passed as a separate variable, never pasted into a
# URL. Still, keep it to what base64 produces rather than inventing punctuation.
POSTGRES_PASSWORD=


# =========================================================================================
# Secrets
# =========================================================================================

# Signs every session token. At least 32 bytes.
#   openssl rand -base64 48
# Changing it signs everyone out, which is a fine way to end a bad test but not something to
# do by accident.
JWT_SECRET=

# Encrypts saved card tokens at rest (AES-256-GCM). Exactly 32 bytes, base64:
#   openssl rand -base64 32
# Keep it. Lose it and every saved card in the database becomes unreadable — and the app
# refuses to start without it under staging, rather than quietly using a development key.
CARD_TOKEN_KEY=


# =========================================================================================
# Telegram
# =========================================================================================

# The token of a TEST bot from @BotFather — never the production bot's.
#
# Two reasons: this server polls (TELEGRAM_BOT_MODE=polling is set in docker-compose.yml),
# and polling DELETES whatever webhook that bot has; and only one process may poll a bot at
# a time, so your local backend and this server would steal each other's updates. Step 9 of
# DEPLOYMENT-AWS.md covers both.
BOT_TOKEN=

# The bot's username, without the @ — used to build game invite deep links. Public.
BOT_USERNAME=

# Optional, without the @: the support account the bot points people at.
SUPPORT_USERNAME=


# =========================================================================================
# Frontend build arguments — all PUBLIC
# =========================================================================================
# Everything starting with VITE_ is inlined into the JavaScript the browser downloads.
# Anyone can read these values. Never put a token, a key or a password behind a VITE_ name.
#
# They are read when the image is BUILT, so changing one needs
# `docker compose up -d --build caddy`, not just a restart.

# The Yandex Maps JavaScript API v3 key (the Mini App's maps). Public, but restrict it by
# HTTP Referer in the Yandex cabinet to this host — step 10 of DEPLOYMENT-AWS.md. Left
# empty, the maps fall back to Leaflet and OpenStreetMap and the app still works.
VITE_YANDEX_MAPS_API_KEY=

# The same bot as BOT_TOKEN above, by its public name: used for
# https://t.me/<bot>/<app>?startapp=... invite links. Without the @.
VITE_TELEGRAM_BOT_USERNAME=

# The Mini App's short name from @BotFather (the /newapp step) — the <app> in that link.
VITE_TELEGRAM_APP_NAME=

# Optional: the support account the "blocked" screen links to. Without the @.
VITE_TELEGRAM_SUPPORT_USERNAME=

# VITE_API_URL is NOT here. It is hard-coded empty in docker-compose.yml: Caddy serves the
# apps and the API on one origin, so the apps call /api on their own origin. Setting it
# would point the browser at some other host and break that.
#
# VITE_DEV_LOGIN_KEY is NOT here either, and must not be added: the dev sign-in does not
# exist in a production build or under the staging profile.
